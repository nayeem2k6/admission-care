
# Copy this file to .env and fill in the values. Never commit .env.

NODE_ENV=development
PORT=5000

# Local MongoDB or an Atlas connection string, e.g.
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/bipu-admission-care?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/bipu-admission-care

# Must be at least 32 characters. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1d

# Allowed browser origin(s). Comma-separate multiple values.
FRONTEND_URL=http://localhost:3000

# Number of reverse proxies in front of this app (see README notes on Vercel + Render).
TRUST_PROXY_HOPS=1

# Required in production, optional in development until uploads are built.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=